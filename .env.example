DATABASE_URL=postgresql://postgres:postgres@localhost:5444/restaurant_ordering
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restaurant_ordering
DB_PORT=5444
DB_CONTAINER_NAME=restaurant-ordering-system-poc-db
API_PORT=3011
API_INTERNAL_URL=http://127.0.0.1:3011
APP_ORIGIN=http://localhost:3010
NODE_ENV=development
# Set before seeding. No built-in staff password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional separate operational account; password must be at least 12 characters.
STAFF_EMAIL=
STAFF_PASSWORD=
# Restaurant-provided PromptPay image URL (HTTPS or a same-origin /path).
PROMPTPAY_QR_URL=
PAYMENT_RECIPIENT=

# Production Compose only (see README)
# PUBLIC_HOST=order.example.com
# PRODUCTION_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@postgres:5432/restaurant_ordering
