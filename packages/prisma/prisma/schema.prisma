generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  USER
  OPERATOR
}
enum MemberRole {
  OWNER
  MANAGER
  STAFF
}
enum TenantStatus {
  ACTIVE
  SUSPENDED
}
enum BranchStatus {
  ACTIVE
  INACTIVE
}
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}
enum QrMode {
  PERMANENT
  SESSION
}
enum SessionMode {
  SINGLE_ORDER
  OPEN_SESSION
}
enum PaymentMode {
  PER_ORDER
  AT_CHECKOUT
  STAFF_MANAGED
}
enum FulfillmentMode {
  SERVE_TO_LOCATION
  PICKUP
}
enum ServicePointType {
  TABLE
  BAR_SEAT
  ZONE
  COUNTER
  PICKUP
  OTHER
}
enum SessionStatus {
  OPEN
  CLOSED
}
enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}
enum PaymentMethod {
  CASH
  PROMPTPAY
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  platformRole PlatformRole @default(USER)
  active       Boolean      @default(true)
  memberships  BranchUser[]
  sessions     AuthSession[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model AuthSession {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  branchId  String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  status       TenantStatus  @default(ACTIVE)
  branches     Branch[]
  memberships  BranchUser[]
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Plan {
  id          String         @id
  name        String
  branchLimit Int
  active      Boolean        @default(true)
  subscriptions Subscription[]
  createdAt   DateTime       @default(now())
}

model Subscription {
  id        String             @id @default(uuid())
  tenantId  String             @unique
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status    SubscriptionStatus @default(TRIAL)
  trialEndsAt DateTime?
  currentPeriodEndsAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  @@index([status, createdAt])
}

model Branch {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name        String
  slug        String
  address     String?
  timezone    String       @default("Asia/Bangkok")
  status      BranchStatus @default(ACTIVE)
  nextOrderNumber Int      @default(1)
  settings    BranchSettings?
  members     BranchUser[]
  menus       Menu[]
  servicePoints ServicePoint[]
  orderSessions OrderSession[]
  orders      Order[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model BranchUser {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId  String
  branch    Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      MemberRole
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  @@unique([userId, branchId])
  @@index([tenantId, branchId, role])
  @@index([userId, active])
}

model BranchSettings {
  branchId        String          @id
  tenantId        String
  branch          Branch          @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  preset          String
  qrMode          QrMode
  sessionMode     SessionMode
  paymentMode     PaymentMode
  fulfillmentMode FulfillmentMode
  promptpayId     String?
  updatedAt       DateTime        @updatedAt
  @@unique([tenantId, branchId])
}

model Menu {
  id        String       @id @default(uuid())
  tenantId  String
  branchId  String
  branch    Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  name      String       @default("Main menu")
  active    Boolean      @default(true)
  categories MenuCategory[]
  products  Product[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, active])
}

model MenuCategory {
  id        String       @id @default(uuid())
  tenantId  String
  branchId  String
  menuId    String
  menu      Menu         @relation(fields: [tenantId, branchId, menuId], references: [tenantId, branchId, id], onDelete: Restrict)
  name      String
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  products  Product[]
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, menuId, sortOrder])
}

model Product {
  id          String       @id @default(uuid())
  tenantId    String
  branchId    String
  menuId      String
  menu        Menu         @relation(fields: [tenantId, branchId, menuId], references: [tenantId, branchId, id], onDelete: Restrict)
  categoryId  String
  category    MenuCategory @relation(fields: [tenantId, branchId, categoryId], references: [tenantId, branchId, id], onDelete: Restrict)
  name        String
  description String?
  imageUrl    String?
  price       Decimal      @db.Decimal(10,2)
  active      Boolean      @default(true)
  available   Boolean      @default(true)
  sortOrder   Int          @default(0)
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, categoryId, sortOrder])
  @@index([tenantId, branchId, active, available])
}

model ServicePoint {
  id          String       @id @default(uuid())
  tenantId    String
  branchId    String
  branch      Branch       @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  name        String
  description String?
  type        ServicePointType @default(TABLE)
  qrToken     String       @unique @default(uuid())
  active      Boolean      @default(true)
  sessions    OrderSession[]
  orders      Order[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  @@unique([tenantId, branchId, id])
  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, active])
}

model OrderSession {
  id             String        @id @default(uuid())
  tenantId       String
  branchId       String
  branch         Branch        @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  servicePointId String?
  servicePoint   ServicePoint? @relation(fields: [tenantId, branchId, servicePointId], references: [tenantId, branchId, id], onDelete: Restrict)
  label          String?
  description    String?
  token          String        @unique @default(uuid())
  status         SessionStatus @default(OPEN)
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @default(0) @db.Decimal(10,2)
  paidAt         DateTime?
  confirmedBy    String?
  orders         Order[]
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, status, openedAt])
  @@index([tenantId, branchId, servicePointId, status])
}

model Order {
  id             String         @id @default(uuid())
  tenantId       String
  branchId       String
  branch         Branch         @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  sessionId      String?
  session        OrderSession?  @relation(fields: [tenantId, branchId, sessionId], references: [tenantId, branchId, id], onDelete: Restrict)
  servicePointId String?
  servicePoint   ServicePoint?  @relation(fields: [tenantId, branchId, servicePointId], references: [tenantId, branchId, id], onDelete: Restrict)
  locationSnapshot String?
  orderNumber    Int
  requestKey     String
  requestHash    String
  status         OrderStatus    @default(NEW)
  paymentMethod  PaymentMethod?
  paymentStatus  PaymentStatus  @default(PENDING)
  subtotal       Decimal        @db.Decimal(10,2)
  total          Decimal        @db.Decimal(10,2)
  paidAt         DateTime?
  confirmedBy    String?
  items          OrderItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  @@unique([tenantId, requestKey])
  @@unique([tenantId, branchId, orderNumber])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, status, createdAt])
  @@index([tenantId, branchId, sessionId, createdAt])
  @@index([tenantId, branchId, paymentStatus, paidAt])
}

model OrderItem {
  id                   String  @id @default(uuid())
  tenantId             String
  branchId             String
  orderId              String
  order                Order   @relation(fields: [tenantId, branchId, orderId], references: [tenantId, branchId, id], onDelete: Restrict)
  productId            String?
  product              Product? @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, id], onDelete: Restrict)
  productNameSnapshot  String
  unitPriceSnapshot    Decimal @db.Decimal(10,2)
  quantity             Int
  note                 String?
  lineTotal            Decimal @db.Decimal(10,2)
  @@index([tenantId, branchId, orderId])
  @@index([tenantId, branchId, productId])
}
